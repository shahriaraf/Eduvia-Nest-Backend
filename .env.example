# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL connection (Neon) ---
# Get this from your Neon project: Dashboard -> Connection Details ->
# "Pooled connection" string. It already includes sslmode=require.
# Example shape (yours will have a real host/user/password):
# postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/eduvia?sslmode=require

# SSL is required by Neon. Leave DB_SSL unset and it's inferred
# automatically (on for Neon/any remote host, off for localhost/Docker's
# local "postgres" service). Set explicitly only to override that:
#   DB_SSL=true   -> force SSL on
#   DB_SSL=false  -> force SSL off (e.g. a local Postgres without SSL)
# DB_SSL=

# --- Fallback: discrete DB_* vars, used only if DATABASE_URL is unset ---
# (e.g. for the local Postgres container in docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=eduvia

# Set to "true" only for a quick local prototype.
# Migrations should be used instead in any shared/production environment.
DB_SYNCHRONIZE=false

# --- Auth ---
# There is a single admin account, configured here rather than a users
# table (see src/auth/README notes) — sign in with these credentials.
# ALWAYS change JWT_SECRET and ADMIN_PASSWORD before deploying anywhere
# other than your own machine.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@eduvia.com
ADMIN_PASSWORD=ChangeMe123!
